{
  "rpc": "get_blocks_bounds",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "block_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": [
    "id",
    "block_ids"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "bounds": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 6,
        "maxItems": 6
      }
    },
    "required": [
      "bounds"
    ],
    "additionalProperties": false
  }
}
