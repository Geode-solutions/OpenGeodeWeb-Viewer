{
  "rpc": "clipping_planes",
  "type": "object",
  "properties": {
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32
      }
    },
    "planes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "normal": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "type": "object",
            "properties": {
              "red": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "green": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "blue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "alpha": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "red",
              "green",
              "blue",
              "alpha"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "origin",
          "normal"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ids",
    "planes"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
