{
  "rpc": "explode",
  "type": "object",
  "properties": {
    "ids": {
      "type": "array",
      "items": {
        "title": "DataId"
      }
    },
    "explode_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "ids",
    "explode_factor"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "exploded_bounds": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "DataId"
            },
            "bounds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "bounds"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "exploded_bounds"
    ],
    "additionalProperties": false
  }
}
