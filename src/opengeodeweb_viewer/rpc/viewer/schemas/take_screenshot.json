{
  "rpc": "take_screenshot",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "output_extension": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "png",
        "jpg"
      ]
    },
    "include_background": {
      "type": "boolean"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    }
  },
  "required": [
    "filename",
    "output_extension",
    "include_background"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "blob": {
        "description": "Image file content, sent as binary"
      }
    },
    "required": [
      "blob"
    ],
    "additionalProperties": false
  }
}
