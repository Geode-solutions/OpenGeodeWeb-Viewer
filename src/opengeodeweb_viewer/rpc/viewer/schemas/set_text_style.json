{
  "rpc": "set_text_style",
  "type": "object",
  "properties": {
    "color": {
      "title": "TextColor",
      "type": "object",
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "r",
        "g",
        "b"
      ],
      "additionalProperties": false
    },
    "font_family": {
      "type": "string",
      "enum": [
        "arial",
        "courier",
        "times"
      ]
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "color",
    "font_family",
    "opacity"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
