{
  "rpc": "apply_basemap",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "detail_of": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "columns": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "map",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "title": "MapState",
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crop": {
            "type": "boolean"
          }
        },
        "required": [
          "map",
          "visible",
          "opacity",
          "crop"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "columns",
    "rows",
    "maps",
    "layers"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
