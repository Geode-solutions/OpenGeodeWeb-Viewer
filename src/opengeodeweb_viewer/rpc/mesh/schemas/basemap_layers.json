{
  "rpc": "basemap_layers",
  "type": "object",
  "properties": {
    "id": {
      "title": "DataId"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "title": "Opacity"
          },
          "crop": {
            "type": "boolean"
          }
        },
        "required": [
          "map",
          "visible",
          "opacity",
          "crop"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "layers"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  }
}
